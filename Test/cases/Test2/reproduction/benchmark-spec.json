  "benchmark_id": "test2-blind-supplement-reproduction",
  "objective": "Use Clef SDK to reconstruct and validate the missing supplementary responsibilities of the Test2 paper without retrieving the publisher supplementary file.",
  "source_policy": {
    "allowed": [
      "Test/cases/Test2/Testarticle.pdf",
      "Test/cases/Test2/review-work/Extractedmd/full.md",
      "Test/cases/Test2/review-work/Report/final-review-report.md",
      "Test/cases/Test2/review-work/Report/decision.json"
    ],
    "forbidden": [
      "publisher supplementary download",
      "network lookup of the DOI attachment",
      ".env or credentials",
      "invented ABAQUS, mesh, material, sample-size or uncertainty values"
    ]
  },
  "dag": [
    {
      "task_id": "inventory-supplement-evidence",
      "depends_on": [],
