    {
      "task_id": "infer-methods-supplement",
      "depends_on": [
        "inventory-supplement-evidence"
      ],
      "outputs": [
        "methods-inference.md",
        "methods-inference.json"
      ]
    },
    {
      "task_id": "validate-paper-numerics",
      "depends_on": [
        "inventory-supplement-evidence"
      ],
      "outputs": [
        "validation-report.md",
        "validation-report.json"
      ]
    },
    {
      "task_id": "synthesize-inferred-supplement",
      "depends_on": [
        "inventory-supplement-evidence",
        "infer-theory-supplement",
        "infer-methods-supplement",
        "validate-paper-numerics"
