{
  "name": "motivo-studio",
  "private": true,
  "version": "0.3.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Offline read-only reports for coding-agent-led Motivo methods",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build",
    "lint": "node --check scripts/build.mjs && node --check tests/reader.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "prettier": "3.9.6"
  }
}
