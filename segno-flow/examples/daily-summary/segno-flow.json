{
  "schema_version": 1,
  "id": "daily-summary",
  "name": "Daily summary example",
  "schedule": {
    "cron_dialect": "unix5",
    "cron": "0 8 * * *",
    "timezone": "America/New_York",
    "dst_gap": "skip",
    "dst_fold": "first",
    "misfire": {"kind": "coalesce"},
    "overlap": {"kind": "forbid"},
    "retry": {"kind": "none"},
    "jitter_seconds": 0
  },
  "scripts": {
    "pre": "scripts/pre.py",
    "main": "scripts/main.py",
    "post": "scripts/post.py"
  }
}
