cabal-version:      3.0
name:               segno-flow
version:            0.3.0.0
synopsis:           Typed persistent workflow driver for Clef and Tactus
description:
  Segno is a small Haskell scheduler for typed Clef workflows. Trigger and
  business-state backends are open JSONL plugins; the single-node driver owns
  only occurrence lifecycle, leases, and waiting.
license:            Apache-2.0
author:             Agenstro contributors
maintainer:         Agenstro contributors
category:           Development
build-type:         Simple
extra-source-files:
    examples/active-window/900_record_active_window.hs
    examples/active-window/README.md

common warnings
  default-language: GHC2021
  ghc-options:      -Wall

common dependencies
  build-depends:
      aeson >=2.2 && <2.3,
      async >=2.2 && <2.3,
      base >=4.20 && <4.23,
      bytestring >=0.12 && <0.13,
      clef-sdk ==0.3.0.0,
      containers >=0.6.8 && <0.8,
      cryptohash-sha256 ==0.11.102.1,
      cron ==0.7.2,
      directory >=1.3.8 && <1.4,
      filepath >=1.4.300 && <1.6,
      process >=1.6 && <1.7,
      scientific >=0.3.8 && <0.4,
      sqlite-simple ==0.4.19.0,
      text >=2.1 && <2.2,
      time >=1.12 && <1.16

library
  import: warnings, dependencies
  hs-source-dirs: haskell/src
  exposed-modules:
      Segno
      Segno.ActiveWindow
      Segno.Driver
      Segno.Lifecycle
      Segno.Plugin
      Segno.Protocol
      Segno.Store.SQLite
      Segno.Trigger.Time
  if os(windows)
    build-depends: Win32 >=2.14 && <2.15

executable segno
  import: warnings, dependencies
  hs-source-dirs: haskell/app
  main-is: Main.hs
  other-modules: Segno.Cli
  build-depends:
      optparse-applicative >=0.18 && <0.20,
      segno-flow

test-suite segno-flow-tests
  import: warnings, dependencies
  type: exitcode-stdio-1.0
  hs-source-dirs: haskell/test
  main-is: Main.hs
  build-depends:
      segno-flow
